Перем Правила;
Перем ЧислоПроверок;

Процедура Проверить(Условие, Имя)
    Если Не Условие Тогда
        ВызватьИсключение "FAIL: " + Имя;
    КонецЕсли;
    ЧислоПроверок = ЧислоПроверок + 1;
    Сообщить("PASS: " + Имя);
КонецПроцедуры

Функция Роли(Имена)
    Возврат СтрРазделить(Имена, ",");
КонецФункции

Функция Строки(Количество, Цена, Товар = "Ноутбук")
    Данные = Новый Массив;
    Данные.Добавить(Новый Структура("Номенклатура,Количество,Цена", Товар, Количество, Цена));
    Возврат Данные;
КонецФункции

Процедура ЖдатьЗапрет(Статус, Действие, ИменаРолей, Своя = Ложь)
    Получена = Ложь;
    Попытка
        Правила.СледующийСтатус(Статус, Действие, Роли(ИменаРолей), 120000, Своя);
    Исключение
        Получена = Истина;
    КонецПопытки;
    Проверить(Получена, "Запрет: " + Статус + "/" + Действие + "/" + ИменаРолей);
КонецПроцедуры

Процедура ЖдатьОшибкаСуммы(Данные, Фрагмент)
    Получена = Ложь;
    Попытка
        Правила.РассчитатьСумму(Данные);
    Исключение
        Получена = СтрНайти(ОписаниеОшибки(), Фрагмент) > 0;
    КонецПопытки;
    Проверить(Получена, "Валидация: " + Фрагмент);
КонецПроцедуры

Правила = ЗагрузитьСценарий("src/CommonModules/ЗакупкиПравила/Ext/Module.bsl");
ЧислоПроверок = 0;
Проверить(Правила.РассчитатьСумму(Строки(2, 99.99)) = 199.98, "Расчет суммы");
Данные = Строки(0.333, 1);
Данные.Добавить(Новый Структура("Номенклатура,Количество,Цена", "Кабель", 0.333, 1));
Проверить(Правила.РассчитатьСумму(Данные) = 0.66, "Округление каждой строки");
ЖдатьОшибкаСуммы(Новый Массив, "должна содержать");
ЖдатьОшибкаСуммы(Строки(1, 1, ""), "номенклатуру");
ЖдатьОшибкаСуммы(Строки(0, 1), "положительными");
ЖдатьОшибкаСуммы(Строки(1, -1), "положительными");
ЖдатьОшибкаСуммы(Строки("2", 1), "числами");
ЖдатьОшибкаСуммы(Строки(1, 1.001), "Цена: два знака");
ЖдатьОшибкаСуммы(Строки(0.0001, 1), "Цена: два знака");
ЖдатьОшибкаСуммы(Строки(0.001, 0.01), "вне допустимого диапазона");
ЖдатьОшибкаСуммы(Строки(10000000, 10000000), "вне допустимого диапазона");
Проверить(Правила.СледующийСтатус("Черновик", "Отправить", Роли("Инициатор"), 120000, Истина)
    = "НаСогласовании", "Отправка своей заявки");
Проверить(Правила.СледующийСтатус("НаСогласовании", "Согласовать", Роли("Руководитель"), 100000, Ложь)
    = "Согласована", "Граница лимита 100000");
Проверить(Правила.СледующийСтатус("НаСогласовании", "Согласовать", Роли("Руководитель"), 100000.01, Ложь)
    = "НаФинКонтроле", "Свыше лимита требуется финансист");
Проверить(Правила.СледующийСтатус("НаФинКонтроле", "Согласовать", Роли("Финансист"), 120000, Ложь)
    = "Согласована", "Финансовое согласование");
Проверить(Правила.СледующийСтатус("Согласована", "Закупить", Роли("Закупщик"), 120000, Ложь)
    = "Закуплена", "Закупщик завершает заявку");
Проверить(Правила.СледующийСтатус("НаСогласовании", "Отклонить", Роли("Руководитель"), 120000, Ложь)
    = "Отклонена", "Отклонение руководителем");
Проверить(Правила.СледующийСтатус("НаФинКонтроле", "Отклонить", Роли("Финансист"), 120000, Ложь)
    = "Отклонена", "Отклонение финансистом");
ЖдатьЗапрет("Черновик", "Отправить", "Инициатор", Ложь);
ЖдатьЗапрет("Черновик", "Закупить", "Закупщик");
ЖдатьЗапрет("НаСогласовании", "Согласовать", "Инициатор");
ЖдатьЗапрет("НаФинКонтроле", "Согласовать", "Руководитель");
ЖдатьЗапрет("НаСогласовании", "Согласовать", "Руководитель", Истина);
ЖдатьЗапрет("НаФинКонтроле", "Согласовать", "Финансист", Истина);
ЖдатьЗапрет("НаСогласовании", "Отклонить", "Руководитель", Истина);
ЖдатьЗапрет("Согласована", "Закупить", "Финансист");
ЖдатьЗапрет("Закуплена", "Отправить", "ПолныеПрава");
ЖдатьЗапрет("Отклонена", "Согласовать", "ПолныеПрава");
ЖдатьЗапрет("НеизвестныйСтатус", "Отправить", "ПолныеПрава");
Проверить(Правила.СледующийСтатус("НаСогласовании", "Согласовать", Роли("ПолныеПрава"), 1, Истина)
    = "Согласована", "Администратор может провести демонстрацию");
Правила.ПроверитьВерсию(7, 7);
Проверить(Истина, "Совпадающая версия разрешена");
ОшибкаПолучена = Ложь;
Попытка
    Правила.ПроверитьВерсию(6, 7);
Исключение
    ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "другим пользователем") > 0;
КонецПопытки;
Проверить(ОшибкаПолучена, "Устаревшая версия запрещена");
Сообщить("OK: " + ЧислоПроверок + " проверок; исполнен исходный BSL-модуль.");
