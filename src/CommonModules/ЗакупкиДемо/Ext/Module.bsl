#Область ПрограммныйИнтерфейс

Функция Создать(Цена = 120000) Экспорт
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Демонстрация доступна только администратору.";
    КонецЕсли;
    Подразделение = Справочники.Подразделения.НайтиПоКоду("DEMO-01");
    Если Подразделение.Пустая() Тогда
        Элемент = Справочники.Подразделения.СоздатьЭлемент();
        Элемент.Код = "DEMO-01";
        Элемент.Наименование = "Разработка";
        Элемент.Записать();
        Подразделение = Элемент.Ссылка;
    КонецЕсли;
    Товар = Справочники.Номенклатура.НайтиПоКоду("DEMO-01");
    Если Товар.Пустая() Тогда
        Элемент = Справочники.Номенклатура.СоздатьЭлемент();
        Элемент.Код = "DEMO-01";
        Элемент.Наименование = "Ноутбук для разработчика";
        Элемент.Записать();
        Товар = Элемент.Ссылка;
    КонецЕсли;
    Заявка = Документы.ЗаявкаНаЗакупку.СоздатьДокумент();
    Заявка.Дата = ТекущаяДатаСеанса();
    Заявка.Подразделение = Подразделение;
    Заявка.Обоснование = "Рабочее место нового сотрудника";
    СтрокаТовара = Заявка.Товары.Добавить();
    СтрокаТовара.Номенклатура = Товар;
    СтрокаТовара.Количество = 1;
    СтрокаТовара.Цена = Цена;
    Заявка.Записать();
    Возврат Заявка.Ссылка;
КонецФункции

#КонецОбласти
