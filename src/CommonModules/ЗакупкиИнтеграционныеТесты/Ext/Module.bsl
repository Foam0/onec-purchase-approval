// Тестовые транзакции всегда откатываются, включая успешный сценарий.
// BSLLS:PairingBrokenTransaction-off
// BSLLS:WrongUseOfRollbackTransactionMethod-off
#Область ПрограммныйИнтерфейс

Процедура ПроверитьВсе() Экспорт
    НачатьТранзакцию();
    Попытка
        Заявка = ЗакупкиДемо.Создать();
        Проверить(Заявка.Версия = 1, "Новая заявка: версия 1");
        Результат = ЗакупкиСервис.ИзменитьСтатус(Заявка, 1, "Отправить");
        Проверить(Результат.Версия = 2, "Отправка: версия 2");
        Результат = ЗакупкиСервис.ИзменитьСтатус(Заявка, 2, "Согласовать");
        Проверить(Результат.Статус = Перечисления.СтатусыЗаявок.НаФинКонтроле, "Нужен финансовый контроль");
        Результат = ЗакупкиСервис.ИзменитьСтатус(Заявка, 3, "Согласовать");
        Проверить(Результат.Статус = Перечисления.СтатусыЗаявок.Согласована, "Согласование финансистом");
        Результат = ЗакупкиСервис.ИзменитьСтатус(Заявка, 4, "Закупить");
        Проверить(Результат.Версия = 5, "Закупка: версия 5");
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ РегистрСведений.ИсторияЗаявок
            |ГДЕ Заявка = &Заявка";
        Запрос.УстановитьПараметр("Заявка", Заявка);
        Выборка = Запрос.Выполнить().Выбрать();
        Выборка.Следующий();
        Проверить(Выборка.Число = 5, "Все пять версий записаны в историю");
        ОтменитьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ПроверитьУстаревшуюВерсию();
    Сообщить("Пройдено 7 интеграционных проверок. Тестовые данные отменены.");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУстаревшуюВерсию()
    НачатьТранзакцию();
    Попытка
        Заявка = ЗакупкиДемо.Создать();
        ЗакупкиСервис.ИзменитьСтатус(Заявка, 1, "Отправить");
        ОшибкаПолучена = Ложь;
        Попытка
            ЗакупкиСервис.ИзменитьСтатус(Заявка, 1, "Согласовать");
        Исключение
            ОшибкаПолучена = СтрНайти(ОписаниеОшибки(), "уже изменена") > 0;
        КонецПопытки;
        ОтменитьТранзакцию();
        Проверить(ОшибкаПолучена, "Устаревшая версия должна быть отклонена");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура Проверить(Условие, Сообщение)
    Если Не Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
