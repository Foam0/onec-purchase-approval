#Область ПрограммныйИнтерфейс

// Привилегированный внутренний модуль, ServerCall=false. Вызывающий сервис
// передает только проверенные полномочия сеанса. Правила маршрута проверяем
// после блокировки и повторного чтения фактического объекта.
//
// Параметры:
//  Заявка - ДокументСсылка.ЗаявкаНаЗакупку - изменяемый документ.
//  ОжидаемаяВерсия - Число - версия из клиентской формы.
//  Действие - Строка - команда маршрута.
//  Комментарий - Строка - проверенный сервисом комментарий.
//  Роли - Массив из Строка - роли текущего сеанса, не клиентские данные.
//  ИмяПользователя - Строка - имя пользователя текущего сеанса.
//
// Возвращаемое значение:
//  Структура - Статус (ПеречислениеСсылка.СтатусыЗаявок), Версия (Число).
Функция ВыполнитьПереход(Заявка, ОжидаемаяВерсия, Действие, Комментарий, Роли, ИмяПользователя) Экспорт
    НачатьТранзакцию();
    Попытка
        Заблокировать(Заявка);
        Объект = Заявка.ПолучитьОбъект();
        Если Объект.ПометкаУдаления Тогда
            ВызватьИсключение "Заявка помечена на удаление.";
        КонецЕсли;
        ЗакупкиПравила.ПроверитьВерсию(ОжидаемаяВерсия, Объект.Версия);
        НовыйСтатус = ЗакупкиПравила.СледующийСтатус(Строка(Объект.Статус),
            Действие, Роли, Объект.Сумма, Объект.Инициатор = ИмяПользователя);
        Объект.Статус = Перечисления.СтатусыЗаявок[НовыйСтатус];
        Объект.ДополнительныеСвойства.Вставить("СлужебныйПереход", Истина);
        Объект.ДополнительныеСвойства.Вставить("КомментарийПерехода", Комментарий);
        Объект.ДополнительныеСвойства.Вставить("АвторПерехода", ИмяПользователя);
        Объект.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Новый Структура("Статус,Версия", Объект.Статус, Объект.Версия);
КонецФункции

Процедура Заблокировать(Заявка) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Документ.ЗаявкаНаЗакупку");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("Ссылка", Заявка);
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ЗаписатьИсторию(ДокументОбъект, Автор, Комментарий) Экспорт
    Запись = РегистрыСведений.ИсторияЗаявок.СоздатьМенеджерЗаписи();
    Запись.Заявка = ДокументОбъект.Ссылка;
    Запись.Версия = ДокументОбъект.Версия;
    Запись.ДатаИзменения = ТекущаяДатаСеанса();
    Запись.Статус = ДокументОбъект.Статус;
    Запись.Пользователь = Автор;
    Запись.Комментарий = Комментарий;
    Запись.Записать();
КонецПроцедуры

#КонецОбласти
