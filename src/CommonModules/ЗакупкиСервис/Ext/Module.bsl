#Область ПрограммныйИнтерфейс

// Единственный серверный интерфейс переходов. Роли и пользователь берутся
// из сеанса, клиент не может передать себе полномочия.
//
// Параметры:
//  Заявка - ДокументСсылка.ЗаявкаНаЗакупку - изменяемый документ.
//  ОжидаемаяВерсия - Число - версия, которую видел пользователь.
//  Действие - Строка - Отправить, Согласовать, Отклонить или Закупить.
//  Комментарий - Строка - причина отклонения или пояснение, до 150 символов.
//
// Возвращаемое значение:
//  Структура - Статус (ПеречислениеСсылка.СтатусыЗаявок), Версия (Число).
Функция ИзменитьСтатус(Заявка, ОжидаемаяВерсия, Действие, Комментарий = "") Экспорт
    Если ТипЗнч(Заявка) <> Тип("ДокументСсылка.ЗаявкаНаЗакупку") Или Не ЗначениеЗаполнено(Заявка) Тогда
        ВызватьИсключение "Выберите заявку.";
    КонецЕсли;
    Если ТипЗнч(ОжидаемаяВерсия) <> Тип("Число") Или ОжидаемаяВерсия < 1 Тогда
        ВызватьИсключение "Некорректная версия заявки.";
    КонецЕсли;
    Если ТипЗнч(Действие) <> Тип("Строка") Или ТипЗнч(Комментарий) <> Тип("Строка") Тогда
        ВызватьИсключение "Действие и комментарий должны быть строками.";
    КонецЕсли;
    Если СтрДлина(Комментарий) > 150 Тогда
        ВызватьИсключение "Комментарий не должен превышать 150 символов.";
    КонецЕсли;
    Если Действие = "Отклонить" И ПустаяСтрока(СокрЛП(Комментарий)) Тогда
        ВызватьИсключение "Укажите причину отклонения.";
    КонецЕсли;
    Роли = Новый Массив;
    Для Каждого ИмяРоли Из СтрРазделить("ПолныеПрава,Инициатор,Руководитель,Финансист,Закупщик", ",") Цикл
        Если РольДоступна(ИмяРоли) Тогда
            Роли.Добавить(ИмяРоли);
        КонецЕсли;
    КонецЦикла;
    Если Роли.Количество() = 0 Тогда
        ВызватьИсключение "Нет роли для работы с заявками.";
    КонецЕсли;
    ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    Возврат ЗакупкиХранилищеПолныеПрава.ВыполнитьПереход(Заявка, ОжидаемаяВерсия, Действие,
        СокрЛП(Комментарий), Роли, ИмяПользователя);
КонецФункции

#КонецОбласти
