#Область ПрограммныйИнтерфейс

Функция РассчитатьСумму(СтрокиТоваров) Экспорт
    Если СтрокиТоваров.Количество() = 0 Тогда
        ВызватьИсключение "Заявка должна содержать товары.";
    КонецЕсли;
    Сумма = 0;
    Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            ВызватьИсключение "Укажите номенклатуру.";
        КонецЕсли;
        Если ТипЗнч(СтрокаТовара.Количество) <> Тип("Число")
            Или ТипЗнч(СтрокаТовара.Цена) <> Тип("Число") Тогда
            ВызватьИсключение "Количество и цена должны быть числами.";
        КонецЕсли;
        Если СтрокаТовара.Количество <= 0 Или СтрокаТовара.Цена <= 0 Тогда
            ВызватьИсключение "Количество и цена должны быть положительными.";
        КонецЕсли;
        Если СтрокаТовара.Цена <> Окр(СтрокаТовара.Цена, 2)
            Или СтрокаТовара.Количество <> Окр(СтрокаТовара.Количество, 3) Тогда
            ВызватьИсключение "Цена: два знака; количество: три знака после запятой.";
        КонецЕсли;
        // Округляем каждую строку, затем суммируем: согласуем тот же итог, что показываем.
        Сумма = Сумма + Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
    КонецЦикла;
    Если Сумма <= 0 Или Сумма >= 10000000000000 Тогда
        ВызватьИсключение "Сумма заявки вне допустимого диапазона.";
    КонецЕсли;
    Возврат Сумма;
КонецФункции

Функция СледующийСтатус(ТекущийСтатус, Действие, Роли, Сумма, СвояЗаявка) Экспорт
    Администратор = Роли.Найти("ПолныеПрава") <> Неопределено;
    Если Сумма <= 0 Тогда
        ВызватьИсключение "Сумма должна быть положительной.";
    КонецЕсли;
    Маршрут = Маршруты().Получить(ТекущийСтатус + ":" + Действие);
    Если Маршрут = Неопределено Тогда
        ВызватьИсключение "Действие недоступно в текущем статусе.";
    КонецЕсли;
    ТребоватьРоль(Роли, Маршрут.Роль);
    Если Действие = "Отправить" И Не СвояЗаявка И Не Администратор Тогда
        ВызватьИсключение "Отправлять можно только свою заявку.";
    КонецЕсли;
    Если Маршрут.Роль = "Руководитель" Или Маршрут.Роль = "Финансист" Тогда
        ПроверитьСамосогласование(СвояЗаявка, Администратор);
    КонецЕсли;
    Если ТекущийСтатус = "НаСогласовании" И Действие = "Согласовать" И Сумма > 100000 Тогда
        Возврат "НаФинКонтроле";
    КонецЕсли;
    Возврат Маршрут.Статус;
КонецФункции

Процедура ПроверитьВерсию(ОжидаемаяВерсия, ФактическаяВерсия) Экспорт
    Если ОжидаемаяВерсия <> ФактическаяВерсия Тогда
        ВызватьИсключение "Заявка уже изменена другим пользователем. Обновите данные.";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Маршруты()
    Результат = Новый Соответствие;
    Результат.Вставить("Черновик:Отправить", Новый Структура("Роль,Статус", "Инициатор", "НаСогласовании"));
    Результат.Вставить("НаСогласовании:Согласовать", Новый Структура("Роль,Статус", "Руководитель", "Согласована"));
    Результат.Вставить("НаСогласовании:Отклонить", Новый Структура("Роль,Статус", "Руководитель", "Отклонена"));
    Результат.Вставить("НаФинКонтроле:Согласовать", Новый Структура("Роль,Статус", "Финансист", "Согласована"));
    Результат.Вставить("НаФинКонтроле:Отклонить", Новый Структура("Роль,Статус", "Финансист", "Отклонена"));
    Результат.Вставить("Согласована:Закупить", Новый Структура("Роль,Статус", "Закупщик", "Закуплена"));
    Возврат Результат;
КонецФункции

Процедура ТребоватьРоль(Роли, Роль)
    Если Роли.Найти(Роль) = Неопределено И Роли.Найти("ПолныеПрава") = Неопределено Тогда
        ВызватьИсключение "Недостаточно прав для действия.";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСамосогласование(СвояЗаявка, Администратор)
    Если СвояЗаявка И Не Администратор Тогда
        ВызватьИсключение "Нельзя согласовывать собственную заявку.";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
