// BSLLS:DataExchangeLoading-off
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    СлужебныйПереход = Ложь;
    ДополнительныеСвойства.Свойство("СлужебныйПереход", СлужебныйПереход);
    Если ЭтоНовый() Тогда
        Если Не РольДоступна("Инициатор") И Не РольДоступна("ПолныеПрава") Тогда
            ВызватьИсключение "Создать заявку может инициатор.";
        КонецЕсли;
        Если ЗначениеЗаполнено(Статус) И Статус <> Перечисления.СтатусыЗаявок.Черновик Тогда
            ВызватьИсключение "Новая заявка должна быть черновиком.";
        КонецЕсли;
        Статус = Перечисления.СтатусыЗаявок.Черновик;
        Инициатор = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
        Версия = 1;
    Иначе
        ЗакупкиХранилищеПолныеПрава.Заблокировать(Ссылка);
        Предыдущий = Ссылка.ПолучитьОбъект();
        ЗакупкиПравила.ПроверитьВерсию(Версия, Предыдущий.Версия);
        Если Не СлужебныйПереход Тогда
            Если Предыдущий.Статус <> Перечисления.СтатусыЗаявок.Черновик Тогда
                ВызватьИсключение "Отправленную заявку нельзя редактировать.";
            КонецЕсли;
            Если Предыдущий.Инициатор <> ПользователиИнформационнойБазы.ТекущийПользователь().Имя
                И Не РольДоступна("ПолныеПрава") Тогда
                ВызватьИсключение "Редактировать можно только свой черновик.";
            КонецЕсли;
            Если Статус <> Предыдущий.Статус Или Инициатор <> Предыдущий.Инициатор Тогда
                ВызватьИсключение "Статус и инициатор изменяются только серверным сервисом.";
            КонецЕсли;
        КонецЕсли;
        Версия = Предыдущий.Версия + 1;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Подразделение) Или ПустаяСтрока(СокрЛП(Обоснование)) Тогда
        ВызватьИсключение "Укажите подразделение и обоснование.";
    КонецЕсли;
    Сумма = ЗакупкиПравила.РассчитатьСумму(Товары);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    Автор = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    Комментарий = "Сохранение черновика";
    ДополнительныеСвойства.Свойство("АвторПерехода", Автор);
    ДополнительныеСвойства.Свойство("КомментарийПерехода", Комментарий);
    ЗакупкиХранилищеПолныеПрава.ЗаписатьИсторию(ЭтотОбъект, Автор, Комментарий);
    ДополнительныеСвойства.Удалить("СлужебныйПереход");
    ДополнительныеСвойства.Удалить("АвторПерехода");
    ДополнительныеСвойства.Удалить("КомментарийПерехода");
КонецПроцедуры

Процедура ПередУдалением(Отказ)
    ВызватьИсключение "Удаление заявок отключено для сохранения истории.";
КонецПроцедуры

#КонецОбласти
